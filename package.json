{
  "name": "aihs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm -r --if-present e2e",
    "db:generate": "pnpm --filter @aihs/api db:generate",
    "db:migrate": "pnpm --filter @aihs/api db:migrate",
    "db:seed": "pnpm --filter @aihs/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "typescript": "7.0.2"
  }
}

{
  "name": "@aihs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aihs/contract": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}

{
  "name": "@aihs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate && biome format --write src/db/migrations",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed/run.ts"
  },
  "dependencies": {
    "@aihs/contract": "workspace:*",
    "@electric-sql/pglite": "0.5.15",
    "@hono/node-server": "2.1.6",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "postgres": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}

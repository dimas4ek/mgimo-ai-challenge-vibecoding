# Скопируй в .env (он в .gitignore). Здесь только заглушки, настоящих секретов в git нет.

# API
PORT=3000
HOST=0.0.0.0

# БД: если DATABASE_URL не задан, API работает на PGlite (dev и тесты).
# DATABASE_URL=postgres://aihs:change-me@localhost:5432/aihs
# Каталог данных PGlite относительно apps/api (в .gitignore).
PGLITE_DIR=.pglite
# Заголовок с адресом клиента для лимита попыток входа. Не задан — последний адрес X-Forwarded-For
# (его дописывает Caddy из deploy/compose.yml). За Cloudflare (Render) задай cf-connecting-ip:
# там последний адрес X-Forwarded-For — прокси платформы, и лимит стал бы общим для всех.
# CLIENT_IP_HEADER=cf-connecting-ip
# Каталог собранной SPA: если задан, API раздаёт её на / (прод). В dev не нужен, фронт отдаёт Vite.
# STATIC_DIR=../web/dist

# Деплой (deploy/compose.yml): docker compose --env-file .env -f deploy/compose.yml up -d --build
# Домен для Caddy, HTTPS выпускается автоматически. localhost — локальная проверка с самоподписанным сертификатом.
DOMAIN=localhost
# Пароль Postgres в контейнере. На сервере замени на длинный случайный, в git не коммить.
POSTGRES_PASSWORD=change-me

# Фронт: моки API (MSW) в dev вместо настоящего API. В прод-сборку не попадают.
# VITE_USE_MOCKS=true

{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "Skill", "Agent",
      "Bash(git:*)", "Bash(gh issue:*)", "Bash(gh pr:*)", "Bash(gh label:*)",
      "Bash(pnpm install:*)", "Bash(pnpm add:*)", "Bash(pnpm remove:*)",
      "Bash(pnpm lint:*)", "Bash(pnpm format:*)", "Bash(pnpm typecheck:*)", "Bash(pnpm test:*)",
      "Bash(pnpm build:*)", "Bash(pnpm dev:*)", "Bash(pnpm e2e:*)", "Bash(pnpm db:*)",
      "Bash(pnpm run:*)", "Bash(pnpm exec:*)", "Bash(pnpm --filter:*)", "Bash(pnpm -r:*)",
      "Bash(node --version)", "Bash(pnpm --version)",
      "Bash(ls:*)", "Bash(mkdir:*)", "Bash(cat:*)", "Bash(cd:*)", "Bash(sleep:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(gh repo delete:*)", "Bash(pnpm dlx:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }
        ]
      }
    ]
  }
}
